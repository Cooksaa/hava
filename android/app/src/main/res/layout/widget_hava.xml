<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Hava (HavaWidget.java). Gore mjesto, temperatura i ikona; dole odgovor
  (šta slijedi s kišom) i veš. Kad je widget visok, odgovor ostaje uz dno, bez rupe.
  Tekst se crta kao slika (HavaWidget.tekst) Havinim fontom, Bricolage Grotesque (OFL,
  assets/OFL-BricolageGrotesque.txt): Xiaomijev početni ekran ignoriše font aplikacije
  u widgetima, a njegov krivo crta č/š/ž. Opis za čitače ekrana ide u contentDescription.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_korijen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pozadina"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_mjesto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="false"
                android:scaleType="fitStart"
                android:importantForAccessibility="yes" />

            <ImageView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="false"
                android:scaleType="fitStart"
                android:importantForAccessibility="yes" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_ikona"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_oblak" />
    </LinearLayout>

    <!-- Rastegne se kad je widget visok, pa odgovor ostaje uz dno. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <ImageView
        android:id="@+id/w_izgled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="false"
        android:scaleType="fitStart"
        android:importantForAccessibility="yes" />

    <ImageView
        android:id="@+id/w_ves"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:adjustViewBounds="false"
        android:scaleType="fitStart"
        android:visibility="gone"
        android:importantForAccessibility="yes" />
</LinearLayout>
