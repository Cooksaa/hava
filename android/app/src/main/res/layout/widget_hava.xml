<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Hava (HavaWidget.java). Gore mjesto, temperatura i ikona; dole odgovor
  (šta slijedi s kišom) i veš. Kad je widget visok, odgovor ostaje uz dno, bez rupe.
  Font: Bricolage Grotesque (OFL, assets/OFL-BricolageGrotesque.txt), kao u aplikaciji;
  sistemski font na Xiaomiju krivo crta č/š/ž u widgetima.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_korijen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pozadina"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_mjesto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/hava_naslov"
                android:singleLine="true"
                android:text="Hava"
                android:textColor="#C7FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="@font/hava_broj"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="54sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_ikona"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_oblak" />
    </LinearLayout>

    <!-- Rastegne se kad je widget visok, pa odgovor ostaje uz dno. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <TextView
        android:id="@+id/w_izgled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/hava_naslov"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="2"
        android:text="Otvori Havu za prognozu"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/w_ves"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/hava_tekst"
        android:maxLines="2"
        android:textColor="#C7FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
