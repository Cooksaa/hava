<?xml version="1.0" encoding="utf-8"?>
<!-- Osvježava se sam svakih 30 min (najčešće što Android dozvoljava), a odmah kad Hava pošalje nove podatke. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_opis"
    android:initialLayout="@layout/widget_hava"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_hava"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
