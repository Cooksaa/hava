    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.6.2",
    "@capgo/capacitor-updater": "8.54.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
